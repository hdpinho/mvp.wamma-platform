# ==============================================================================
# WAMMA Platform — Plantilla de Variables de Entorno (.env.example)
# Copia este archivo como .env y completa con tus credenciales
# ==============================================================================

SPRING_PROFILES_ACTIVE=supabase

# Pooler de Supabase en modo sesión (5432). Si una VPN bloquea ese puerto, el modo
# transacción (6543) del mismo host sirve para desarrollo local.
# Ojo: al arrancar, el backend aplica en esta base las migraciones de Flyway pendientes.
# Para probar sin tocar la base compartida, usar el servidor local con PostgreSQL
# embebido: mvn spring-boot:test-run -Dspring-boot.run.main-class=com.wamma.support.LocalDevServer
SUPABASE_DB_URL=jdbc:postgresql://<host-pooler>:5432/postgres?sslmode=require
SUPABASE_DB_USER=postgres.<project-ref>
SUPABASE_DB_PASSWORD=tu_contraseña_aqui

# Opcional — rol de aplicación con mínimo privilegio (V0009). Cuando se active
# wamma_app, SUPABASE_DB_USER pasa a ser wamma_app.<project-ref> y Flyway sigue
# migrando con el dueño del esquema:
# FLYWAY_DB_USER=postgres.<project-ref>
# FLYWAY_DB_PASSWORD=contraseña_del_dueño

# Orígenes del frontend autorizados (separados por coma). Vite usa el 5173.
WAMMA_CORS_ORIGINS=http://localhost:5173

# Claves del módulo 001 (plan 001 §7): 32 bytes aleatorios en Base64, distintas entre sí.
# Sin ellas el servidor no arranca. Se generan en PowerShell con:
#   $b = New-Object byte[] 32; [Security.Cryptography.RandomNumberGenerator]::Create().GetBytes($b); [Convert]::ToBase64String($b)
WAMMA_CLAVE_CIFRADO=
WAMMA_CLAVE_INDICE=

# Primer administrador (D-07): solo se usa si la base no tiene ningún usuario.
# La contraseña inicial debe tener al menos 12 caracteres; se cambia en el primer ingreso.
WAMMA_ADMIN_USUARIO=
WAMMA_ADMIN_NOMBRE=
WAMMA_ADMIN_APELLIDO=
WAMMA_ADMIN_CORREO=
WAMMA_ADMIN_CONTRASENA_INICIAL=
